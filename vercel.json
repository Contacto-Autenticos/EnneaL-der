{
    "rewrites": [
        {
            "source": "/eneagrama(.*)",
            "destination": "/eneagrama.html"
        },
        {
            "source": "/dominios(.*)",
            "destination": "/dominios.html"
        },
        {
            "source": "/agenda",
            "destination": "/agenda.html"
        },
        {
            "source": "/diagnostico-empresarial(.*)",
            "destination": "/diagnostico-empresarial.html"
        },
        {
            "source": "/liderazgo-test-intro(.*)",
            "destination": "/liderazgo-test-intro.html"
        },
        {
            "source": "/liderazgo-test(.*)",
            "destination": "/liderazgo-test.html"
        },
        {
            "source": "/liderazgo-results(.*)",
            "destination": "/liderazgo-results.html"
        },
        {
            "source": "/inscripcion-haz-que-suceda(.*)",
            "destination": "/haz-que-suceda.html"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}